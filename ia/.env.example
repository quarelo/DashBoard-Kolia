DATABASE_URL=postgresql+psycopg2://kolia:kolia@postgres:5432/kolia
# Must match SECRET_KEY in backend/.env — this service verifies tokens issued by the backend's /login
SECRET_KEY=
ALGORITHM=HS256
MAX_TOKENS_PER_CHUNK=2500
OVERLAP_TOKENS=200
EMBEDDING_DIM=768
OLLAMA_GENERATE_URL=http://ollama:11434/api/generate
OLLAMA_EMBED_URL=http://ollama:11434/api/embed
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=512
OLLAMA_CHUNK_THINK=true
OLLAMA_CHUNK_NUM_PREDICT=768
OLLAMA_CONSOLIDATION_THINK=true
OLLAMA_CONSOLIDATION_NUM_PREDICT=1024
MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
