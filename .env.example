# Copie para .env na raiz e preencha. Único .env do projeto. Lido por três consumidores:
#   - docker compose (interpolação ${VAR} no docker-compose.yml)
#   - backend/core/config.py       (caminho absoluto até este arquivo)
#   - ia/src/app/core/config.py    (idem)
# Dentro dos containers este arquivo não existe: o Compose injeta os mesmos
# valores como variáveis de ambiente, que têm precedência sobre qualquer arquivo.

# --- Postgres -----------------------------------------------------------
POSTGRES_DB=kolia
POSTGRES_USER=kolia
POSTGRES_PASSWORD=kolia

# Usada só FORA do Docker; 5433 é a porta que o compose publica no host.
# Dentro do Docker o Compose sobrescreve com o host interno "postgres:5432".
DATABASE_URL=postgresql+psycopg2://kolia:kolia@localhost:5433/kolia

# --- Autenticação -------------------------------------------------------
# Mínimo 32 caracteres; o backend recusa subir com valor vazio ou curto.
# Aceito como SECRET_KEY ou JWT_SECRET pelas duas configs. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-uma-chave-de-32-bytes-em-hex-gerada-localmente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- Backend ------------------------------------------------------------
# Em produção a IA não deve ter ingresso público.
IA_SERVICE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:5173"]

# --- Modelos ------------------------------------------------------------
# Escolhido contra gemma3:1b, qwen2.5:3b, qwen3:4b-instruct, qwen2.5:7b-instruct
# e qwen3.5:9b-q4_K_M numa GTX 1070 Ti de 8 GB; números em docs/prompts.md.
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_CHUNK_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_CONSOLIDATION_MODEL=qwen3.5:4b-q4_K_M
EMBEDDING_MODEL=nomic-embed-text

# Com GPU NVIDIA e o NVIDIA Container Toolkit instalado, descomente para o Ollama
# usar a GPU. Sem GPU deixe comentado: a reserva faz o `docker compose up` falhar
# sem o runtime da NVIDIA. (No Windows fora do WSL o separador é ";".)
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Fora do Docker aponte para o host; o Compose sobrescreve com "ollama:11434".
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate
OLLAMA_EMBED_URL=http://localhost:11434/api/embed

# Janela de contexto. Com 32768 o pico medido de VRAM foi 5.640 de 8.192 MiB.
# OLLAMA_CONTEXT_LENGTH vale para o pipeline; CHAT_CONTEXT_LENGTH, para o chat.
OLLAMA_CONTEXT_LENGTH=32768
CHAT_CONTEXT_LENGTH=32768

# --- Consolidação e score -----------------------------------------------
# Consolidação por LLM: a determinística gravava trecho cru no final_summary.
FAST_DETERMINISTIC_CONSOLIDATION=false
# 768 truncava: a resposta com dúvidas raciocinadas deu 1256 e 1355 tokens.
OLLAMA_CONSOLIDATION_NUM_PREDICT=1536
# Os códigos de motivo que o modelo declara pontuam churn e oportunidade.
TRUST_DECLARED_MOTIVES=true

# --- Fatiamento e embeddings -------------------------------------------
# Mantenha os dois juntos: mudar só um altera as fronteiras dos chunks e,
# com elas, os embeddings já gravados no pgvector.
MAX_TOKENS_PER_CHUNK=2000
OVERLAP_TOKENS=120

# Precisa bater com o modelo de embedding e com a coluna Vector já criada.
EMBEDDING_DIM=768

# Orçamento de tokens do resumo de chunk. 192 truncava e cada truncamento
# custa uma segunda chamada com o dobro: medido em 14 reuniões, 192 gastou
# 180s com 4 retries contra 132s e nenhum em 256. Com o qwen3.5:4b-q4_K_M,
# 256/384/512 não truncaram nenhuma vez; 384 é margem.
OLLAMA_CHUNK_NUM_PREDICT=384
