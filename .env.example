POSTGRES_DB=kolia
POSTGRES_USER=kolia
POSTGRES_PASSWORD=kolia

OLLAMA_MODEL=qwen3:1.7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
MAX_TOKENS_PER_CHUNK=1000
OVERLAP_TOKENS=0

OLLAMA_CHUNK_MODEL=qwen3:1.7b
OLLAMA_CONSOLIDATION_MODEL=qwen3:1.7b
OLLAMA_CHUNK_THINK=false
OLLAMA_CHUNK_NUM_PREDICT=192
OLLAMA_CONSOLIDATION_THINK=false
OLLAMA_CONSOLIDATION_NUM_PREDICT=384
OLLAMA_KEEP_ALIVE=30m
OLLAMA_GENERATE_TIMEOUT_SECONDS=600
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120
OLLAMA_READ_TIMEOUT_RETRIES=1
OLLAMA_JSON_REPAIR_ENABLED=true
ANALYSIS_WORKER_CONCURRENCY=1
CHUNK_PROCESSING_CONCURRENCY=1
PARTIAL_CHUNK_COUNT=6
MAX_LLM_CHUNKS=15
FAST_TRANSCRIPTION_RETENTION_RATIO=0.05
FAST_DETERMINISTIC_CONSOLIDATION=true
